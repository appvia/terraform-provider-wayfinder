        "properties": {
          "displayName": {
            "type": "string",
            "required": true
          },
          "summary": {
            "type": "string"
          },
          "quota": {
            "type": "object",
            "properties": {
              "maxCpu": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ]
}
